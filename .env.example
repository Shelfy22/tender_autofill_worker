# API
ENVIRONMENT=production
LOG_LEVEL=INFO
API_KEY=replace-with-a-long-random-value
API_MAX_BATCH_JOBS=25
TENDER_API_PORT=8000
# External Docker network shared with PostgreSQL, Qdrant and Ollama.
TENDER_EXTERNAL_NETWORK=ai-net

# Existing PostgreSQL used by n8n. Encode special URL characters.
POSTGRES_DSN=postgresql://user:password@postgres-host:5432/database
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

# Durable execution timeline/counters in the same PostgreSQL.
OBSERVABILITY_ENABLED=true
OBSERVABILITY_HEARTBEAT_SECONDS=30

# Redis/Celery
# Dedicated Redis from this Compose; never point this at the n8n/BullMQ Redis.
REDIS_URL=redis://tender-redis:6379/0
CELERY_QUEUE=tender-autofill
# Existing n8n Controller requeues processing after 30 minutes.
# Keep hard timeout below that value, or increase both settings together.
CELERY_SOFT_TIME_LIMIT_SECONDS=1500
CELERY_HARD_TIME_LIMIT_SECONDS=1680
WORKER_MEMORY_LIMIT=4g

# Per-tender filesystem and safety limits
TEMP_ROOT=/tmp/tender-autofill
MAX_DOCUMENTS=100
MAX_DOWNLOAD_BYTES_PER_FILE=104857600
MAX_DOWNLOAD_BYTES_TOTAL=524288000
MAX_ARCHIVE_MEMBERS=500
MAX_ARCHIVE_UNCOMPRESSED_BYTES=524288000
MAX_ARCHIVE_COMPRESSION_RATIO=100
MAX_ARCHIVE_DEPTH=1
MAX_TEXT_CHARS_PER_FILE=250000
MAX_COMBINED_TEXT_CHARS=500000
MAX_PRODUCT_TEXT_CHARS=250000
MAX_DECISION_TEXT_CHARS=220000
PDF_OCR_MAX_BYTES=26214400
HTTP_CONNECT_TIMEOUT_SECONDS=15
HTTP_READ_TIMEOUT_SECONDS=120
DOCUMENT_DOWNLOAD_TIMEOUT_SECONDS=180
CONVERSION_TIMEOUT_SECONDS=120

# Seldon. Do not copy credentials from the n8n export; rotate them first.
SELDON_BASE_URL=https://apitorgi.myseldon.com
SELDON_USERNAME=
SELDON_PASSWORD=

# OpenAI-compatible endpoint (the exported workflow uses OpenRouter credentials).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Defaults below are the actual models connected in the exported n8n workflow.
LLM_MODEL_ATTEMPT_1=google/gemini-3.5-flash
LLM_MODEL_ATTEMPT_2=google/gemini-2.5-pro
LLM_MODEL_ATTEMPT_3=openai/gpt-5.5
# OpenRouter will try the primary attempt model, then the other models for every AI call.
LLM_ENABLE_MODEL_FALLBACK=true
# Optional comma-separated override; empty uses the three attempt models above.
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=300
LLM_MAX_OUTPUT_TOKENS=16000
OCR_MODEL=google/gemini-2.5-flash
# OCR fallback models must support PDF/file input. Empty means no OCR model fallback.
OCR_FALLBACK_MODELS=
OCR_PDF_ENGINE=mistral-ocr

# IPro
IPRO_BASE_URL=https://idev.etm.ru/api/ipro/user/registration_ipro
IPRO_TOKEN=

# Catalog: disabled | http (custom catalog service) | qdrant (remote Qdrant REST API)
CATALOG_MODE=qdrant
CATALOG_SEARCH_URL=
CATALOG_API_KEY=
CATALOG_TIMEOUT_SECONDS=120
QDRANT_URL=https://qdrant.example.internal
QDRANT_API_KEY=
QDRANT_COLLECTION=products
# Leave empty for the collection's unnamed/default dense vector.
QDRANT_VECTOR_NAME=
QDRANT_TOP_K=50
OLLAMA_URL=
OLLAMA_EMBEDDING_MODEL=qwen3-embedder-ft:latest

# Active n8n sub-workflow path used structured Seldon pageText, not an HTML GET.
ENABLE_TENDER_HTML_FETCH=false
LIBREOFFICE_BINARY=libreoffice
SEVEN_ZIP_BINARY=7z
UNAR_BINARY=unar
LSAR_BINARY=lsar
